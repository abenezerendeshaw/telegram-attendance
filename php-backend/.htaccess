RewriteEngine On
RewriteBase /evaluation/

# Pass Authorization header to PHP (LiteSpeed / Apache strips it)
RewriteCond %{HTTP:Authorization} .+
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── Webhook routing: /evaluation/webhook/[slug] → /evaluation/webhook/index.php?c=[slug] ────────
RewriteRule ^webhook/shared/?$ webhook/shared.php [QSA,L]
RewriteRule ^webhook/([a-z0-9_-]+)/?$ webhook/index.php?c=$1 [QSA,L]
RewriteRule ^webhook/([a-z0-9_-]+)/$ webhook/index.php?c=$1 [QSA,L]

# ── API routing: /evaluation/api/endpoint → /evaluation/api/endpoint.php ────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([a-z0-9_-]+)/?$ api/$1.php [L,QSA]

# Handle OPTIONS preflight — return 204 and let PHP set headers if needed
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [L,QSA]

# ── Remove trailing slashes ───────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# ── Security: Block direct PHP execution in uploads ───────────────────────
RewriteRule ^uploads/.*\.php$ - [F,L]

# ── PHP settings for shared hosting (safe wrapper for PHP-FPM / LiteSpeed) ────
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 256M
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set Referrer-Policy strict-origin-when-cross-origin
</IfModule>
